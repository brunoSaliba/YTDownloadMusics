# Copie para deploy/.env na VPS. Sem segredos nesta aplicação.
# Tag da imagem (latest ou o SHA do commit para rollback).
IMAGE_TAG=latest
MAX_DURATION_SECONDS=900
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_INFO=2
# 1 = yt-dlp só por IPv6 (use se o YouTube bloquear o IPv4 da VPS com "not a bot").
FORCE_IPV6=0
# Cookies do YouTube: o arquivo ./youtube-cookies.txt é montado em /run/secrets/youtube_cookies
# (padrão). Só mude se usar outro caminho dentro do container.
# YOUTUBE_COOKIES_FILE=/run/secrets/youtube_cookies
JOB_TIMEOUT_SECONDS=240
INFO_TIMEOUT_SECONDS=45
MAX_FILESIZE_MB=100
